{
  "name": "escape-game-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Cooperative Boardgame & Escape Game Platform Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "start": "node apps/gateway/dist/index.js",
    "build": "npm run build --workspaces --if-present && npm run build:web",
    "build:web": "node scripts/build-web.js",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
